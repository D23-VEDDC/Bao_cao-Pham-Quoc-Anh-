# ==============================================================================
# 1. CẤU HÌNH CONSOLE, WEBSOCKET & TFLITE AI
CONFIG_VEDC_FORCE_TFLM_REFERENCE=y
# ==============================================================================
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_HTTPD_WS_SUPPORT=y

# ESP-NN: dùng kernel ASM tối ưu cho ESP32-S3 (nhanh hơn nhiều so với ANSI-C
# tham chiếu). Trước đây bị ép về ANSI-C chỉ để so sánh đầu ra lúc debug -
# nay trả lại chế độ tối ưu vì kết quả đã được xác nhận khớp.
CONFIG_NN_OPTIMIZED=y
CONFIG_NN_OPTIMIZATIONS=1

# CPU 240MHz thay vì 160MHz mặc định trước đây: tăng trực tiếp tốc độ giải
# mã JPEG và tốc độ chạy model TFLite-Micro (Conv2D/DepthwiseConv2D).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# ==============================================================================
# 2. BẬT BỘ NHỚ RAM NGOÀI (PSRAM OCTAL 8MB - BẮT BUỘC CHO BAN N16R8)
# Khắc phục triệt để: UVC stream failed (ESP_ERR_NO_MEM) & HTTP 500
# ==============================================================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_CRITICAL_CAPTIVE_MEMORY=y

# ==============================================================================
# 3. CẤU HÌNH FLASH 16MB & BẢNG PHÂN VÙNG (DÀNH CHO CHIP N16R8)
# ==============================================================================
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ==============================================================================
# 4. USB HOST / UVC WEBCAM (SỬA LỖI LOGITECH C270 ENUMERATION)
# ==============================================================================
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# ==============================================================================
# 5. TỐI ƯU WIFI / LWIP & SOCKET (CHỐNG TRÀN SOCKET ERRNO 23 & GIẢM LAG STREAM)
# ==============================================================================
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_GMAC_SUPPORT=n

CONFIG_FREERTOS_HZ=1000

CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_TCP_HIGH_SPEED_RETRANSMISSION=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# Mở rộng Socket chống lỗi ENFILE (errno 23) khi chạy Web + WebSockets + DNS
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_LWIP_MAX_LISTENING_TCP=16

# ==============================================================================
# 6. TỐI ƯU MÃ HÓA VÀ HIỆU NĂNG COMPILER
# ==============================================================================
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y